rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public to create and read appointments (leads)
    match /appointments/{appointmentId} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Allow public to read services, settings and CMS content
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /cms_content/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin only sections
    match /admins/{adminId} {
      allow read: if request.auth != null;
    }

    match /business_settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /business_hours/{hourId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /blocked_dates/{dateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /invoices/{invoiceId} {
      allow read, write: if request.auth != null;
    }
    
    match /contracts/{contractId} {
      allow read, write: if request.auth != null;
    }
  }
}
